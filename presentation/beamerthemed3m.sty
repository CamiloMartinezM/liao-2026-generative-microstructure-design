% d3M research-talk theme for Beamer (XeLaTeX or LuaLaTeX).
% Colours follow the Universitaet des Saarlandes corporate design (blue lead
% colour, red and dark-blue accents). Text is Latin Modern Sans, the
% OpenType Computer Modern Sans; code is FiraCode Nerd Font Mono. Navigation
% is the Frankfurt / smoothbars mini-frame headline; blocks and footer
% borrow the plain, square TU Delft look. Load with \usetheme{d3m} and the
% class option compress.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemed3m}[2026/10/20 d3M talk theme]

\RequirePackage{fontspec}
\RequirePackage{etoolbox}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,decorations.pathmorphing}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{fontawesome5}
\RequirePackage{booktabs,tabularx,array,colortbl}
\renewcommand\tabularxcolumn[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}

% ---------------------------------------------------------------- colours
% UdS style guide, screen RGB values (pp. 18-19); green only marks passing
% tests in the TDD loop.
\definecolor{udsblue}{RGB}{0,73,118}
\definecolor{udsdark}{RGB}{1,40,63}
\definecolor{udsred}{RGB}{199,23,72}
\definecolor{udsgrey}{RGB}{110,110,110}
\definecolor{udsgreymid}{RGB}{145,145,145}
\definecolor{udsgreylight}{RGB}{190,190,190}
\definecolor{udsgreypale}{RGB}{230,230,230}
\definecolor{testgreen}{RGB}{0,122,74}
\colorlet{bluetint}{udsblue!8}
\colorlet{redtint}{udsred!8}
\colorlet{greentint}{testgreen!9}
\colorlet{darktint}{udsgreypale!55}

% ------------------------------------------------------------------ fonts
% Sans: fontspec's default Latin Modern Sans, with optical sizes. Mono:
% FiraCode Nerd Font Mono (https://www.nerdfonts.com) without its code
% ligatures, so `->` and `!=` print as typed; Latin Modern Mono otherwise.
\IfFontExistsTF{FiraCode Nerd Font Mono}
  {\setmonofont{FiraCode Nerd Font Mono}[Scale=0.86,Contextuals=NoAlternate]}
  {\setmonofont{Latin Modern Mono}}

\setbeamercolor{normal text}{fg=udsdark,bg=white}
\setbeamercolor{structure}{fg=udsblue}
\setbeamercolor{alerted text}{fg=udsred}
\setbeamercolor{frametitle}{fg=udsblue}
\setbeamercolor{framesubtitle}{fg=udsgrey}
\setbeamerfont{frametitle}{size=\fontsize{16.5}{19}\selectfont,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\fontsize{9}{11}\selectfont,series=\mdseries}
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=8mm,text margin right=8mm}

% ------------------------------------------- Frankfurt mini-frame headline
% Section names in one row, one circle per frame below each name; the
% current frame is filled. The mechanism is beamer's \insertnavigation in
% compressed mode, as in the smoothbars outer theme used by Frankfurt.
\beamer@compresstrue
\setbeamercolor{section in head/foot}{fg=white,bg=udsblue}
\setbeamerfont{section in head/foot}{size=\fontsize{6.8}{8}\selectfont}
\setbeamertemplate{section in head/foot}{\textcolor{white}{\insertsectionhead}}% explicit: links are coloured
\setbeamertemplate{section in head/foot shaded}%
  {\textcolor{white!55!udsblue}{\insertsectionhead}}
\setbeamercolor{mini frame}{fg=white}
\setbeamersize{mini frame size=1.6mm,mini frame offset=0.35mm}
\def\dtm@dot#1{\beamer@xelatex@fixminiframes
  \begin{pgfpicture}{0pt}{0pt}{1.2mm}{1.2mm}
    \pgfsetlinewidth{0.45pt}
    \pgfpathcircle{\pgfpoint{0.6mm}{0.6mm}}{0.47mm}
    \pgfusepath{#1}
  \end{pgfpicture}}
\setbeamertemplate{mini frame}{\dtm@dot{fill,stroke}}
\setbeamertemplate{mini frame in current subsection}{\dtm@dot{stroke}}
\setbeamertemplate{mini frame in other subsection}{\dtm@dot{stroke}}
\setbeamertemplate{mini frame in other section}%
  {\color{white!45!udsblue}\dtm@dot{stroke}}
\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=4.4mm,dp=3.8mm]{section in head/foot}%
    \hbox to\paperwidth{\hskip5mm\insertnavigation{\dimexpr\paperwidth-10mm\relax}\hss}%
  \end{beamercolorbox}%
}

% ------------------------------------------------------ per-frame citation
% Frame option source={...}: a short citation printed in the footer.
\let\dtm@framesource\@empty
\define@key{beamerframe}{source}{\def\dtm@framesource{#1}}
% Beamer processes frame options outside the frame's group: reset them.
\BeforeBeginEnvironment{frame}{\let\dtm@framesource\@empty}
% Columns otherwise start with a full empty \baselineskip below the title.
\BeforeBeginEnvironment{columns}{\par\nointerlineskip}
% [T] columns: beamer lifts a column's first item by 1ex, and only boxes such as blocks undo
% it; start every column at its top edge so text, images and blocks begin at the same height.
% Re-arming the minipage flag, as a fresh minipage does, also drops a list's top space there.
\define@key{beamer@col}{T}[true]{\def\beamer@colmode{T}\def\beamer@colalign{t}%
  \def\beamer@colheadskip{\par\nointerlineskip\@minipagetrue\everypar{\@minipagefalse\everypar{}}}}
% Beamer opens each frame body with an empty box and, except on plain frames, lets a first line
% of text take full line spacing below it; drop that space on every frame.
\patchcmd{\beamer@frameslide}{\ifbeamer@plainframe\nointerlineskip\fi}{\nointerlineskip}{}%
  {\PackageWarning{beamerthemed3m}{Could not patch the start of the frame body}}

% ------------------------------------------------------------- frame title
% The phantom gives every title line the same depth, with or without descenders, so the
% content starts at the same distance below every title.
\def\dtm@titledepth{\vphantom{gjpqy}}
\setbeamertemplate{frametitle}{%
  \nointerlineskip\vskip3.6mm
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=8mm,rightskip=8mm plus 1fil]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle\dtm@titledepth\par
    \ifx\insertframesubtitle\@empty\else
      \vskip0.8mm{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
        \insertframesubtitle\dtm@titledepth\par}%
    \fi
  \end{beamercolorbox}%
}

% ------------------------------------------------- footer (TU Delft style)
% UdS logo bottom left with its clear space, then the frame's citation;
% short title and frame number bottom right, all centred on the logo's
% height. \udslogo can be redefined if the logo file moves.
\newcommand\udslogo{assets/uds-logo.pdf}
\setbeamercolor{footline}{fg=udsgrey}
\setbeamerfont{footline}{size=\fontsize{6.2}{7}\selectfont}
\setbeamertemplate{footline}{%
  \vbox to 9mm{\vfill
    \hbox to\paperwidth{\hskip8mm
      $\vcenter{\hbox{\includegraphics[width=13mm]{\udslogo}}}$\hskip4mm
      \ifx\dtm@framesource\@empty\else
        \parbox[c]{108mm}{\fontsize{5.8}{6.8}\selectfont\color{udsgrey}\raggedright
          \dtm@framesource}%
      \fi\hfill
      \ifbeamer@noframenumbering\else
        $\vcenter{\hbox{\usebeamerfont{footline}\usebeamercolor[fg]{footline}%
          \insertshorttitle\hskip2.5mm{\color{udsblue}\bfseries\insertframenumber}}}$%
      \fi
      \hskip8mm}%
    \vskip3mm}%
}

% ------------------------------------------------------------ speaker notes
% Each note starts with its time in bold, then one point per line, so a glance finds the next one.
\AtBeginNote{\parindent=0pt\parskip=1.1mm\raggedright}

% ------------------------------------------------------------------ lists
\setbeamertemplate{itemize item}{\raisebox{0.32ex}{\color{udsblue}\rule{1.05mm}{1.05mm}}}
\setbeamertemplate{itemize subitem}{\raisebox{0.4ex}{\color{udsblue!70}\rule{0.8mm}{0.8mm}}}
\setbeamertemplate{enumerate item}{\color{udsblue}\bfseries\insertenumlabel.}
\setbeamertemplate{enumerate subitem}{\color{udsblue}\insertsubenumlabel)}
\setlength{\leftmargini}{4mm}
\setlength{\leftmarginii}{3.5mm}

% ------------------------------------------- blocks (square, tinted body)
\setbeamertemplate{blocks}[default]
\setbeamercolor{block title}{fg=white,bg=udsblue}
\setbeamercolor{block body}{fg=udsdark,bg=bluetint}
\setbeamerfont{block title}{size=\small,series=\bfseries}
\setbeamerfont{block body}{size=\small}

\tcbset{d3m/.style={enhanced,sharp corners,boxrule=0pt,frame hidden,
    left=1.8mm,right=1.8mm,top=1.3mm,bottom=1.5mm,toptitle=0.7mm,bottomtitle=0.7mm,
    fonttitle=\small\bfseries,fontupper=\small,coltext=udsdark,
    before upper=\raggedright,before title=\raggedright,
    before skip=0pt,after skip=2mm}}
% Blue: information; red: human decisions and warnings; dark: files and
% other artifacts; green: passing tests; plain: untitled panel.
\newtcolorbox{dblock}[2][]{d3m,colback=bluetint,colbacktitle=udsblue,coltitle=white,title={#2},#1}
\newtcolorbox{ablock}[2][]{d3m,colback=redtint,colbacktitle=udsred,coltitle=white,title={#2},#1}
\newtcolorbox{fblock}[2][]{d3m,colback=darktint,colbacktitle=udsdark,coltitle=white,title={#2},#1}
\newtcolorbox{gblock}[2][]{d3m,colback=greentint,colbacktitle=testgreen,coltitle=white,title={#2},#1}
\newtcolorbox{panel}[1][]{d3m,colback=darktint,#1}

% ------------------------------------------------------------------- code
\lstdefinestyle{d3m}{basicstyle=\ttfamily\fontsize{7.6}{9.3}\selectfont,
  columns=fullflexible,keepspaces=true,showstringspaces=false,upquote=true,
  aboveskip=0pt,belowskip=0pt,frame=none,tabsize=4,escapechar=§}
\lstdefinelanguage{md}{morecomment=[l][\color{udsblue}\bfseries]{\#},
  moredelim=[s][\color{udsred!80!black}]{`}{`},sensitive=true}
\lstdefinestyle{py}{style=d3m,language=Python,
  keywordstyle=\color{udsblue}\bfseries,commentstyle=\color{udsgrey},
  stringstyle=\color{udsred!80!black}}
% Shell, TOML, YAML and .gitignore: '#' comments in grey, double-quoted strings.
\lstdefinelanguage{sh}{morecomment=[l]{\#},morestring=[b]",sensitive=true}
\lstdefinestyle{sh}{style=d3m,language=sh,commentstyle=\color{udsgrey},
  stringstyle=\color{udsred!80!black}}
\lstset{style=d3m}
% A file shown as in an editor: a white tab with an icon and the file's path in the top-left
% corner, a grey tab bar beside it, and a white page below. The title background is white and the
% grey bar is drawn only right of the tab; the border is a line, not a filled frame behind the
% page, so no grey can show between tab and page.
\newcommand\dtm@filetab[1]{%
  \tikz[baseline=(t.south)]{\node[inner xsep=1.8mm,inner ysep=0.8mm,text height=1.9mm,
      text depth=0.6mm,font=\ttfamily\fontsize{7}{8}\selectfont,text=udsdark,
      path picture={\draw[udsblue,line width=0.9pt] (path picture bounding box.north west)
        -- (path picture bounding box.north east);}] (t)
      {\textcolor{udsblue}{\faIcon[regular]{file-alt}}\enspace#1};
    % the bar runs to the box's right edge; clip title rounds its corner
    \fill[darktint,overlay] (t.south east) rectangle ([xshift=\linewidth]t.north west);}}
\tcbset{d3mfile/.style={enhanced,arc=1.2mm,boxrule=0.5pt,frame hidden,
    borderline={0.5pt}{0.25pt}{udsgreylight},colback=white,
    colbacktitle=white,coltext=udsdark,titlerule=0pt,boxsep=0pt,
    left=2.8mm,right=2.8mm,top=2.2mm,bottom=2.2mm,before skip=0pt,after skip=2mm,
    % after left and right, which also set the title's side space; tab and bar fill the title,
    % clipped to the box's rounded corners
    lefttitle=0pt,righttitle=0pt,toptitle=0pt,bottomtitle=0pt,clip title}}
\newtcblisting{codefile}[2][]{d3mfile,listing only,title={\dtm@filetab{#2}},
  listing options={style=d3m,language=md,#1}}
% A terminal window: dark, rounded, with three dots and a centred title. The background is the
% one of the Windows Terminal screenshot, so a screenshot in a terminalwindow sits in seamlessly.
% Prompts ($) are green and comments grey; output keeps the text colour, or § escapes colour it.
\definecolor{termbg}{RGB}{12,12,12}
\definecolor{termfg}{RGB}{226,226,226}
\definecolor{termdim}{RGB}{150,150,150}
\definecolor{termgreen}{RGB}{110,200,120}
\definecolor{termred}{RGB}{255,110,115}
\definecolor{termorange}{RGB}{232,160,105}
\definecolor{termblue}{RGB}{120,175,235}
\definecolor{termdot1}{RGB}{255,95,87}
\definecolor{termdot2}{RGB}{254,188,46}
\definecolor{termdot3}{RGB}{40,200,64}
\lstdefinestyle{term}{style=sh,commentstyle=\color{termdim},stringstyle=\color{termorange},
  literate={\$}{{\textcolor{termgreen}{\$}}}1}
\tcbset{d3mterm/.style={enhanced,arc=1.2mm,boxrule=0pt,frame hidden,colback=termbg,
    colbacktitle=termbg,coltitle=termdim,coltext=termfg,fonttitle=\ttfamily\fontsize{7}{8}\selectfont,
    halign title=center,toptitle=1.2mm,bottomtitle=0.2mm,titlerule=0pt,
    left=2.2mm,right=2.2mm,top=1.2mm,bottom=1.6mm,before skip=0pt,after skip=2mm,
    overlay={\foreach \c [count=\i] in {termdot1,termdot2,termdot3}
      \fill[\c] ([xshift=\i*2.3mm-0.3mm]title.west) circle (0.7mm);}}}
\newtcblisting{terminal}[2][]{d3mterm,listing only,title={#2},listing options={style=term,#1}}
\newtcolorbox{terminalwindow}[2][]{d3mterm,title={#2},#1}
% A folder tree on a white page with the file window's border, drawn alike on every slide: blue
% folder icons, grey file icons, names in mono, guides from each row to its parent, and notes and
% badges in their own columns (x in mm from the page's inner left edge).
%   \begin{foldertree}[note at=29,badge at=56,row height=4]
%     \tdir{0}{sem-seg/}{}  \tfile{1}{pyproject.toml}{what the project needs}  ...
%   \end{foldertree}
% Depth 0 is a root. \tbadge{<tikz style>}{text} badges the last row; \tstrike strikes its name.
\newcounter{dtm@trow}
\pgfkeys{/dtmtree/.cd,note at/.store in=\dtm@tnotex,badge at/.store in=\dtm@tbadgex,
  row height/.store in=\dtm@trowh,note at=30,badge at=56,row height=4.2}
\def\dtm@tindent{3.4}% mm per level
\newtcolorbox{dtm@treebox}{enhanced,arc=1.2mm,boxrule=0.5pt,frame hidden,
  borderline={0.5pt}{0.25pt}{udsgreylight},colback=white,coltext=udsdark,boxsep=0pt,
  left=2.4mm,right=2.4mm,top=2mm,bottom=2mm,before skip=0pt,after skip=2mm}
\newenvironment{foldertree}[1][]
  {\pgfkeys{/dtmtree/.cd,#1}\setcounter{dtm@trow}{0}\dtm@tclear{-1}%
   \begin{dtm@treebox}\begin{tikzpicture}[x=1mm,y=1mm]}
  {\end{tikzpicture}\end{dtm@treebox}}
% forget the last rows below depth #1, so the next row at a deeper level starts a new branch
\newcommand\dtm@tclear[1]{\count@=#1\relax
  \loop\ifnum\count@<8 \advance\count@ by 1
    \expandafter\global\expandafter\let\csname dtm@tlast\the\count@\endcsname\relax\repeat}
% #1 depth, #2 icon, #3 name, #4 note
\newcommand\dtm@trow[4]{%
  \stepcounter{dtm@trow}%
  \pgfmathsetmacro\dtm@ty{-(\value{dtm@trow}-1)*\dtm@trowh}%
  \pgfmathsetmacro\dtm@tix{#1*\dtm@tindent+1.4}%
  \ifnum#1>0
    % the guide runs under the parent's icon: from its previous sibling, or from below the parent
    \pgfmathsetmacro\dtm@tgx{(#1-1)*\dtm@tindent+1.4}%
    \expandafter\ifx\csname dtm@tlast\number#1\endcsname\relax
      \pgfmathsetmacro\dtm@tya{\csname dtm@tlast\number\numexpr#1-1\relax\endcsname-1.5}%
    \else
      \edef\dtm@tya{\csname dtm@tlast\number#1\endcsname}%
    \fi
    \draw[udsgreylight,line width=0.5pt] (\dtm@tgx,\dtm@tya) -- (\dtm@tgx,\dtm@ty) -- (\dtm@tix-1.2,\dtm@ty);
  \fi
  \expandafter\xdef\csname dtm@tlast\number#1\endcsname{\dtm@ty}%
  \dtm@tclear{#1}%
  \node[inner sep=0pt,font=\scriptsize] at (\dtm@tix,\dtm@ty) {#2};
  \node[anchor=west,inner sep=0pt,font=\ttfamily\fontsize{7.2}{8}\selectfont,text=udsdark] (tname)
    at (\dtm@tix+1.9,\dtm@ty) {#3};
  \ifx\relax#4\relax\else
    \node[anchor=west,inner sep=0pt,font=\scriptsize,text=udsgrey] at (\dtm@tnotex,\dtm@ty) {#4};
  \fi}
\newcommand\tdir[3]{\dtm@trow{#1}{\textcolor{udsblue}{\faFolderOpen}}{#2}{#3}}
\newcommand\tfile[3]{\dtm@trow{#1}{\textcolor{udsgreymid}{\faIcon[regular]{file-alt}}}{#2}{#3}}
% Rows that stand for parts left as they were, in grey.
\newcommand\tdirgrey[3]{\dtm@trow{#1}{\textcolor{udsgreylight}{\faFolderOpen}}{\textcolor{udsgreymid}{#2}}{#3}}
\newcommand\tfilegrey[3]{\dtm@trow{#1}{\textcolor{udsgreylight}{\faIcon[regular]{file-alt}}}%
  {\textcolor{udsgreymid}{#2}}{#3}}
% The same rows inside another tikzpicture[x=1mm,y=1mm], so that arrows can join a tree to other
% drawings: \treestart{note at=..,row height=..} starts a tree whose first row is at y = 0 of the
% current scope, and x = 0 is the page's inner left edge of a foldertree. Draw the page yourself.
\newcommand\treestart[1]{\pgfkeys{/dtmtree/.cd,#1}\setcounter{dtm@trow}{0}\dtm@tclear{-1}}
\newcommand\tbadge[2]{\node[anchor=west,inner xsep=1mm,inner ysep=0.45mm,
  font=\fontsize{7}{8}\selectfont\bfseries,#1] at (\dtm@tbadgex,\dtm@ty) {#2};}
\newcommand\tstrike{\draw[udsred,line width=0.6pt] (tname.west) -- (tname.east);}

% ---------------------------------------------------------------- helpers
\newcommand\fn[1]{\texttt{#1}}
% Author followed by a gap, or nothing when \author{} is empty.
\newcommand\authorandgap{\ifx\beamer@shortauthor\@empty\else\insertauthor\quad\fi}

% ------------------------------------------------------------ TikZ styles
% Colour carries meaning, but every node is also labelled in words.
\tikzset{
  every picture/.append style={line cap=butt},
  box/.style={draw=udsgreylight,line width=0.5pt,fill=white,inner sep=1.2mm,
    font=\footnotesize,text=udsdark,align=center},
  agent/.style={box,draw=udsblue,fill=bluetint},
  human/.style={box,draw=udsred,fill=redtint},
  artifact/.style={box,draw=udsdark,fill=darktint,font=\ttfamily\scriptsize},
  flow/.style={-{Stealth[length=1.7mm,width=1.3mm]},line width=0.6pt,draw=udsdark},
  lbl/.style={font=\scriptsize,text=udsgrey,inner sep=0.6mm},
  % a numbered marker on a screenshot: \node[number mark] at (x,y) {1};
  number mark/.style={circle,fill=udsred,text=white,font=\scriptsize\bfseries,inner sep=0pt,
    minimum size=4mm},
}
% The same marker in a line of text, for example as the label of the item it numbers:
% \item[\numbermark{1}] or \numbermark{1} in a table cell.
\newcommand\numbermark[1]{\tikz[baseline=-0.75ex]\node[number mark]{#1};}

% ----------------------------------------------- task specification cards
% The five parts of a task specification (objective, context, constraints, acceptance,
% verification) as cards at the same x positions on every slide that shows them, below a request
% drawn as a terminal. Inside a tikzpicture[x=1mm,y=1mm]:
%   \specterminal{y top}{title}: a terminal window across the text width; (term) is where its
%     text starts, set in [spec request] nodes with \specspace between them
%   \speccard{k}{y top}{y bottom}{label}{body fill}: card k (0 to 4) with a blue head; (hk) is
%     the head, (bk) where its body text starts
%   \specfilecard{k}{y top}{y bottom}{label}{body fill}: the same with a dark head and a file
%     icon, for a part that comes from files
\tikzset{
  spec request/.style={font=\ttfamily\fontsize{7.6}{9}\selectfont,inner sep=0pt,anchor=base west,
    text=termfg,execute at begin node={\setbox0\hbox{x}\spaceskip=\wd0\relax}},
  % a fixed text height and depth put every head's label on the same baseline
  spec head/.style={anchor=north west,minimum width=28.4mm,text width=25.6mm,inner xsep=1.4mm,
    inner ysep=0pt,minimum height=5.4mm,text height=1.9mm,text depth=0.6mm,
    font=\scriptsize\bfseries,text=white,fill=udsblue,align=left},
  spec body/.style={anchor=north west,text width=25.6mm,inner sep=0pt,font=\scriptsize,
    text=udsdark,align=left,execute at begin node={\hyphenpenalty=10000\raggedright}},
  spec chip/.style={draw=udsgreylight,fill=white,rounded corners=0.6mm,inner xsep=0.8mm,
    inner ysep=0.7mm,anchor=north west,font=\ttfamily\fontsize{7}{8}\selectfont,text=udsdark,
    path picture={\draw[udsblue,line width=0.9pt] (path picture bounding box.north west)
      -- (path picture bounding box.north east);}},
  spec skill/.style={spec chip,draw=udsblue,path picture={}},
  spec note/.style={anchor=north west,inner sep=0pt,font=\scriptsize,text=udsgrey,
    text width=25.6mm,align=left,execute at begin node={\hyphenpenalty=10000\raggedright}},
}
\newcommand\specterminal[2]{%
  \fill[termbg,rounded corners=1.2mm] (0,#1) rectangle (144,#1-12.4);
  \foreach \c [count=\i] in {termdot1,termdot2,termdot3} \fill[\c] (\i*2.3+0.4,#1-2.6) circle (0.7);
  \node[inner sep=0pt,font=\ttfamily\fontsize{7}{8}\selectfont,text=termdim] at (72,#1-2.6) {#2};
  \draw[white!18!termbg,line width=0.4pt] (0,#1-5.2) -- (144,#1-5.2);
  \coordinate (term) at (2.4,#1-9.6);}
% #6 is the head's fill
\newcommand\dtm@speccard[6]{%
  \node[spec head,fill=#6] (h#1) at (#1*28.9,#2) {#4};
  \fill[#5] (#1*28.9,#2-5.4) rectangle (#1*28.9+28.4,#3);
  \coordinate (b#1) at (#1*28.9+1.4,#2-6.8);}
\newcommand\speccard[5]{\dtm@speccard{#1}{#2}{#3}{#4}{#5}{udsblue}}
\newcommand\specfilecard[5]{\dtm@speccard{#1}{#2}{#3}{#4}{#5}{udsdark}%
  \node[anchor=east,inner sep=0pt,text=white,font=\scriptsize] at (#1*28.9+27,#2-2.7)
    {\faIcon[regular]{file-alt}};}
% one character's space in the request, which TikZ would trim at the edge of a node
\newcommand\specspace{\hbox to 0.6em{}}

% ------------------------------------------------------- section divider
% Stylised code lines for the divider band: #1 random seed, #2 left edge
% and #3 top in mm, #4 number of lines. Lines are indented and ragged like code.
\newcommand\dtm@codelines[4]{%
  \pgfmathsetseed{#1}%
  \foreach \dtm@r in {1,...,#4}{%
    \pgfmathrandominteger{\dtm@ind}{0}{3}%
    \pgfmathrandominteger{\dtm@n}{0}{5}%
    \pgfmathsetmacro\dtm@y{#3-(\dtm@r-1)*3.6}%
    \pgfmathsetmacro\dtm@x{#2+4*\dtm@ind}%
    \xdef\dtm@xs{\dtm@x}%
    \ifnum\dtm@n>0
      \foreach \dtm@s in {1,...,\dtm@n}{%
        \pgfmathsetmacro\dtm@w{3+11*rnd}%
        \fill[udsblue!20] (\dtm@xs,\dtm@y) rectangle ++(\dtm@w,-1.2);%
        \pgfmathsetmacro\dtm@t{\dtm@xs+\dtm@w+1.5}%
        \xdef\dtm@xs{\dtm@t}%
      }%
    \fi
  }}
% \sectionframe{number}{title}{guiding question}{icon}: TU Delft-style
% centred box over a 160 x 52 mm band of code lines; the mini-frame headline
% stays visible. The icon is a fontawesome command such as \faCodeBranch.
\newcommand\sectionframe[4]{%
  \begin{frame}[noframenumbering]
  \begin{tikzpicture}[remember picture,overlay]
    \fill[bluetint] ([yshift=-8.2mm]current page.north west)
      rectangle ([yshift=-60.2mm]current page.north east);
    \begin{scope}[shift={([yshift=-8.2mm]current page.north west)},x=1mm,y=1mm]
      \dtm@codelines{\number#1}{8}{-4}{13}
      \dtm@codelines{1#1}{84}{-4}{13}
    \end{scope}
    \node[fill=udsblue,text=white,text width=90mm,align=center,inner xsep=6mm,
      inner ysep=4.5mm,anchor=center,execute at begin node={\hyphenpenalty=10000}]
      (box) at ([yshift=-58mm]current page.north) {%
      {\fontsize{13}{15}\selectfont #4}\enspace{\fontsize{11}{13}\selectfont #1}\par\vskip1.4mm
      {\color{white!70!udsblue}\rule{12mm}{0.6pt}}\par\vskip1.8mm
      {\fontsize{17}{20}\selectfont\bfseries #2}\par\vskip2mm
      {\fontsize{8.6}{11}\selectfont\color{white!88!udsblue}#3}};
    \fill[udsred] (box.north east) rectangle ([xshift=1.6mm]box.south east);
  \end{tikzpicture}
  \end{frame}}

\endinput
